fn min(x: [num]) -> num {
  let mut ret = nan;
  for el in x {
    if !(el >= ret) {
      ret = el;
    }
  }
  ret
}

fn max(x: [num]) -> num {
  let mut ret = nan;
  for el in x {
    if !(el <= ret) {
      ret = el;
    }
  }
  ret
}

fn total(x: [num]) -> num {
  let mut ret = 0.0;
  for el in x {
    ret += el;
  }
  ret
}

fn mean(x: [num]) -> num {
  total(x) / x.count
}

fn var(x: [num]) -> num {
  let mut ret = 0.0;
  let m = mean(x);
  for el in x {
    ret += (el - m) * (el - m);
  }
  ret / x.count
}

fn varp(x: [num]) -> num {
  let mut ret = 0.0;
  let m = mean(x);
  for el in x {
    ret += (el - m) * (el - m);
  }
  ret / (x.count - 1.0)
}

fn stdev(x: [num]) -> num {
  sqrt(var(x))
}

fn stdevp(x: [num]) -> num {
  sqrt(varp(x))
}

fn stddev(x: [num]) -> num {
  stdev(x)
}

fn stddevp(x: [num]) -> num {
  stdevp(x)
}

fn cov(a: [num], b: [num]) -> num {
  let ma = mean(a);
  let mb = mean(b);
  let mut ret = 0.0;
  for el1, el2 in a, b {
    ret += (el1 - ma) * (el2 - mb);
  }
  ret / a.count
}

fn covp(a: [num], b: [num]) -> num {
  let ma = mean(a);
  let mb = mean(b);
  let mut ret = 0.0;
  for el1, el2 in a, b {
    ret += (el1 - ma) * (el2 - mb);
  }
  ret / (a.count - 1)
}

fn corr(a: [num], b: [num]) -> num {
  covp(a, b) / (stdevp(a) * stdevp(b))
}

