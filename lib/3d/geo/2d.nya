use "2d/geo";
use "3d/point";
use "3d/geo/cons";

fn ->(p: Point) -> Point3D {
  Point3D { x: p.x, y: p.y, z: 0 }
}

fn ->(l: Line) -> Line3D {
  Line3D {
    p1: l.p1 -> Point3D,
    p2: l.p2 -> Point3D,
  }
}

fn ->(l: Ray) -> Ray3D {
  Ray3D {
    p1: l.p1 -> Point3D,
    p2: l.p2 -> Point3D,
  }
}

fn ->(l: Vector) -> Vector3D {
  Vector3D {
    p1: l.p1 -> Point3D,
    p2: l.p2 -> Point3D,
  }
}

fn ->(l: Segment) -> Segment3D {
  Segment3D {
    p1: l.p1 -> Point3D,
    p2: l.p2 -> Point3D,
  }
}

fn ->(l: Circle) -> Circle3D {
  Circle3D {
    normal: xyplane.normal,
    center: l.center -> Point3D,
    radius: l.radius,
  }
}

fn ->(l: Angle) -> Angle3D {
  Angle3D {
    p1: l.p1 -> Point3D,
    p2: l.p2 -> Point3D,
    p3: l.p3 -> Point3D,
  }
}

fn ->(l: DirectedAngle) -> DirectedAngle3D {
  DirectedAngle3D {
    p1: l.p1 -> Point3D,
    p2: l.p2 -> Point3D,
    p3: l.p3 -> Point3D,
  }
}
