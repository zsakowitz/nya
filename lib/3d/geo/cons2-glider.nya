use "3d/point";
use "3d/geo/defs";

fn glider(c: Circle3D, p: num) -> Point3D {
  let p = 2.0 * pi * @clamp(p, 0.0, 1.0);
  let alt = %point(-c.normal.y, -c.normal.z, -c.normal.x);
  let n1 = %cross(c.normal.end, alt);
  let n2 = %cross(c.normal.end, n1);
  c.center + c.radius * (cos(p) * n1 + sin(p) * n2)
}

fn glider(c: Segment3D, p: num) -> Point3D {
  @mix(c.p1, c.p2, @clamp(p, 0.0, 1.0))
}

fn glider(c: Ray3D, p: num) -> Point3D {
  @mix(c.p1, c.p2, max(0, p))
}

fn glider(c: Line3D, p: num) -> Point3D {
  @mix(c.p1, c.p2, p)
}
