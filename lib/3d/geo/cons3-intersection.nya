use "3d/geo/defs";

//! https://stackoverflow.com/a/2316934
// gives the point closest to two lines
fn ishtersection(
  l1: Segment3D | Ray3D | Line3D,
  l2: Segment3D | Ray3D | Line3D,
) -> Point3D {
  let p1 = l1.p1;
  let p2 = l1.p2;
  let p3 = l2.p1;
  let p4 = l2.p2;

  let d13 = p1 - p3;
  let d21 = p2 - p1;
  let d43 = p4 - p3;

  let d1321 = @dot(d13, d21);
  let d1343 = @dot(d13, d43);
  let d2121 = @dot(d21, d21);
  let d4321 = @dot(d43, d21);
  let d4343 = @dot(d43, d43);

  let denom = d2121 * d4343 - d4321 * d4321;
  if denom == 0 {
    _point_nan
  } else {
    p1 + (d1343 * d4321 - d1321 * d4343) / denom * d21
  }
}

// https://en.wikipedia.org/wiki/Line%E2%80%93plane_intersection
fn intersection(p: Plane, line: Segment3D | Ray3D | Line3D) -> Point3D {
  let n = p.normal.end;
  let p0 = -n * p.offset;
  let l0 = line.p1;
  let l = @norm(line.p2 - l0);
  let denom = @dot(l, n);
  if denom == 0 {
    _point_nan
  } else {
    l0 + l * (@dot(p0 - l0, n) / denom)
  }
}

fn intersection(line: Segment3D | Ray3D | Line3D, p: Plane) -> Point3D {
  intersection(p, line)
}

fn intersection(p1: Plane, p2: Plane) -> Line3D {
  let n1 = p1.normal.end;
  let h1 = -p1.offset;
  let n2 = p2.normal.end;
  let h2 = -p2.offset;

  let dot = @dot(n1, n2);
  let denom = 1.0 - dot * dot;
  if denom == 0.0 {
    return Line3D { p1: _point_nan, p2: _point_nan };
  }

  let c1 = (h1 - h2 * dot) / denom;
  let c2 = (h2 - h1 * dot) / denom;
  let p1 = c1 * n1 + c2 * n2;

  Line3D {
    p1,
    p2: p1 + %cross(n1, n2),
  }
}

fn intersection(p1: Plane, p2: Plane, p3: Plane) -> Point3D {
  ishtersection(intersection(p1, p2), intersection(p2, p3))
}
