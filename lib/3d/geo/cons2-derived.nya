use "3d/point";
use "3d/geo/defs";
use "3d/geo/cons1-basic";

fn glider(c: Circle3D, p: num) -> Point3D {
  let p = 2.0 * pi * @clamp(p, 0.0, 1.0);
  let alt = %point(-c.normal.y, -c.normal.z, -c.normal.x);
  let n1 = %cross(c.normal.end, alt);
  let n2 = %cross(c.normal.end, n1);
  c.center + c.radius * (cos(p) * n1 + sin(p) * n2)
}

fn glider(l: Segment3D, p: num) -> Point3D {
  @mix(l.p1, l.p2, @clamp(p, 0.0, 1.0))
}

fn glider(l: Ray3D, p: num) -> Point3D {
  @mix(l.p1, l.p2, max(0, p))
}

fn glider(l: Line3D, p: num) -> Point3D {
  @mix(l.p1, l.p2, p)
}

fn perpendicular(l: Segment3D | Ray3D | Line3D, p: Point3D) -> Plane {
  perpendicular(vector(l.p1, l.p2), p)
}

fn angle_bisector(a: Angle3D) -> Ray3D {
  let n1 = @norm(a.p1 - a.p2);
  let n3 = @norm(a.p3 - a.p2);
  let dir = @norm(n1 + n3);
  Ray3D {
    p1: a.p2,
    p2: a.p2 + dir,
  }
}

//! https://stackoverflow.com/a/2316934
// gives the point closest to two lines
fn ishtersection(
  l1: Segment3D | Ray3D | Line3D,
  l2: Segment3D | Ray3D | Line3D,
) -> Point3D {
  let p1 = l1.p1;
  let p2 = l1.p2;
  let p3 = l2.p1;
  let p4 = l2.p2;

  let d13 = p1 - p3;
  let d21 = p2 - p1;
  let d43 = p4 - p3;

  let d1321 = @dot(d13, d21);
  let d1343 = @dot(d13, d43);
  let d2121 = @dot(d21, d21);
  let d4321 = @dot(d43, d21);
  let d4343 = @dot(d43, d43);

  let denom = d2121 * d4343 - d4321 * d4321;
  if denom == 0 {
    _point_nan
  } else {
    p1 + (d1343 * d4321 - d1321 * d4343) / denom * d21
  }
}
