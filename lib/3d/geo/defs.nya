use "2d/geo";
use "3d/point";

struct Sphere {
  center: Point3D,
  radius: num,
}

struct Offset3D {
  x: num,
  y: num,
  z: num,
}

struct Circle3D {
  center: Point3D,
  normal: Offset3D,
  radius: num,
}

struct Triangle3D {
  p1: Point3D,
  p2: Point3D,
  p3: Point3D,
}

// TODO: figure out a neater thing for perpendicular+parallel+length than having
// all of the above coerce into a new thing
// or just use coercions and ditch Alt
struct Segment3D, Line3D, Ray3D, Vector3D, AnyLine3D, AnySlope3D {
  p1: Point3D,
  p2: Point3D,
}

struct Plane {
  normal: Offset3D,
  offset: num,
}

struct Angle3D, DirectedAngle3D, AnyAngle3D {
  p1: Point3D,
  p2: Point3D,
  p3: Point3D,
}

fn start(v: Vector3D) -> Point3D {
  v.p1
}

fn end(v: Vector3D) -> Point3D {
  v.p2
}

fn end(x: Offset3D) -> Point3D {
  Point3D { x: x.x, y: x.y, z: x.z }
}

fn %plot_3d(cv: Canvas3D, p: Offset3D) -> Object3D {
  cv.segment(0, 0, 0, p.x, p.y, p.z)
}

fn %plot_3d(cv: Canvas3D, obj: Sphere) -> Object3D {
  cv.sphere(obj.center.x, obj.center.y, obj.center.z, obj.radius)
}

fn %plot_3d(cv: Canvas3D, p: Plane) -> Object3D {
  let c = p.normal;
  cv.plane(c.x, c.y, c.z, p.offset)
}

fn %plot_3d(cv: Canvas3D, p: Circle3D) -> Object3D {
  let c = p.center;
  let d = p.normal;
  cv.circle(c.x, c.y, c.z, d.x, d.y, d.z, p.radius)
}

fn %plot_3d(cv: Canvas3D, p: Triangle3D) -> Object3D {
  let p1 = p.p1;
  let p2 = p.p2;
  let p3 = p.p3;
  cv.triangle(p1.x, p1.y, p1.z, p2.x, p2.y, p2.z, p3.x, p3.y, p3.z)
}

fn %plot_3d(cv: Canvas3D, p: Segment3D) -> Object3D {
  let p1 = p.p1;
  let p2 = p.p2;
  cv.segment(p1.x, p1.y, p1.z, p2.x, p2.y, p2.z)
}

fn %plot_3d(cv: Canvas3D, p: Ray3D) -> Object3D {
  let p1 = p.p1;
  let p2 = p.p2;
  cv.ray(p1.x, p1.y, p1.z, p2.x, p2.y, p2.z)
}

fn %plot_3d(cv: Canvas3D, p: Line3D) -> Object3D {
  let p1 = p.p1;
  let p2 = p.p2;
  cv.line(p1.x, p1.y, p1.z, p2.x, p2.y, p2.z)
}

fn %plot_3d(cv: Canvas3D, p: Angle3D) -> Object3D {
  let p1 = p.p1;
  let p2 = p.p2;
  let p3 = p.p3;
  cv.angle(p1.x, p1.y, p1.z, p2.x, p2.y, p2.z, p3.x, p3.y, p3.z)
}

// TODO: plot angle3d

//! https://stackoverflow.com/a/19730129
fn ->(x: Angle3D) -> num {
  let v1 = @norm(x.p1 @- x.p2);
  let v2 = @norm(x.p3 @- x.p2);
  acos(@dot(v1, v2))
}

fn ->(x: Segment3D) -> AnyLine3D {
  AnyLine3D {
    p1: x.p1,
    p2: x.p2,
  }
}

fn ->(x: Line3D) -> AnyLine3D {
  AnyLine3D {
    p1: x.p1,
    p2: x.p2,
  }
}

fn ->(x: Ray3D) -> AnyLine3D {
  AnyLine3D {
    p1: x.p1,
    p2: x.p2,
  }
}

fn ->(x: AnyLine3D) -> AnySlope3D {
  AnySlope3D {
    p1: x.p1,
    p2: x.p2,
  }
}

fn ->(x: Vector3D) -> AnySlope3D {
  AnySlope3D {
    p1: x.p1,
    p2: x.p2,
  }
}

fn ->(x: Angle3D) -> AnyAngle3D {
  AnyAngle3D {
    p1: x.p1,
    p2: x.p2,
    p3: x.p3,
  }
}

fn ->(x: DirectedAngle3D) -> AnyAngle3D {
  AnyAngle3D {
    p1: x.p1,
    p2: x.p2,
    p3: x.p3,
  }
}
