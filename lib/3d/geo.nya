use "3d/point";

struct Sphere {
  center: Point3D,
  radius: num,
}

fn sphere(center: Point3D, radius: num) -> Sphere {
  Sphere { center, radius }
}

fn %plot_3d(cv: Canvas3D, obj: Sphere) -> Object3D {
  cv.sphere(obj.center.x, obj.center.y, obj.center.z, obj.radius)
}

struct Plane {
  normal: Point3D,
  offset: num,
}

fn plane(normal: Point3D, offset: num) -> Plane {
  Plane { normal, offset }
}

struct Torus {
  cx: num,
  cy: num,
  cz: num,
  rx: num,
  ry: num,
  rz: num,
  radius: num,
  lineWidth: num,
}

fn torus(
  cx: num,
  cy: num,
  cz: num,
  rx: num,
  ry: num,
  rz: num,
  radius: num,
  lineWidth: num,
) -> Torus {
  Torus { cx, cy, cz, rx, ry, rz, radius, lineWidth }
}

fn %plot_3d(cv: Canvas3D, p: Torus) -> Object3D {
  cv.torus(p.cx, p.cy, p.cz, p.rx, p.ry, p.rz, p.radius, p.lineWidth)
}

expose package {
  default: true,
  name: "3D geometry",
}
