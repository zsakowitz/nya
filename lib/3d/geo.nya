use "3d/point";

struct Direction3D {
  _dir: Point3D,
}

struct Vector3D {
  start: Point3D,
  end: Point3D,
}

struct Sphere {
  center: Point3D,
  radius: num,
}

struct Plane {
  normal: Direction3D,
  offset: num,
}

struct Circle3D {
  center: Point3D,
  direction: Direction3D,
  radius: num,
}

struct Triangle3D {
  p1: Point3D,
  p2: Point3D,
  p3: Point3D,
}

struct Segment3D, Line3D {
  p1: Point3D,
  p2: Point3D,
}

fn %plot_3d(cv: Canvas3D, obj: Sphere) -> Object3D {
  cv.sphere(obj.center.x, obj.center.y, obj.center.z, obj.radius)
}

fn %plot_3d(cv: Canvas3D, p: Plane) -> Object3D {
  let c = p.normal._dir;
  cv.plane(c.x, c.y, c.z, p.offset)
}

fn %plot_3d(cv: Canvas3D, p: Circle3D) -> Object3D {
  let c = p.center;
  let d = p.direction._dir;
  cv.circle(c.x, c.y, c.z, d.x, d.y, d.z, p.radius)
}

fn %plot_3d(cv: Canvas3D, p: Triangle3D) -> Object3D {
  let p1 = p.p1;
  let p2 = p.p2;
  let p3 = p.p3;
  cv.triangle(p1.x, p1.y, p1.z, p2.x, p2.y, p2.z, p3.x, p3.y, p3.z)
}

fn %plot_3d(cv: Canvas3D, p: Segment3D) -> Object3D {
  let p1 = p.p1;
  let p2 = p.p2;
  cv.segment(p1.x, p1.y, p1.z, p2.x, p2.y, p2.z)
}

// TODO: %plot_3d for Line3D

fn ->(a: Vector3D) -> Direction3D {
  Direction3D { _dir: a.end @- a.start }
}

fn vector(_dir: Point3D) -> Direction3D {
  Direction3D { _dir }
}

fn vector(start: Point3D, end: Point3D) -> Vector3D {
  Vector3D { start, end }
}

fn sphere(center: Point3D, radius: num) -> Sphere {
  Sphere { center, radius: abs(radius) }
}

fn normal(p1: Point3D, p2: Point3D, p3: Point3D) -> Direction3D {
  Direction3D { _dir: @norm(%cross(p3 @- p2, p1 @- p2)) }
}

fn plane(normal: Direction3D, offset: num) -> Plane {
  Plane { normal, offset }
}

fn plane(normal: Direction3D, point: Point3D) -> Plane {
  Plane {
    normal,
    offset: -@dot(point, normal._dir),
  }
}

fn plane(p1: Point3D, p2: Point3D, p3: Point3D) -> Plane {
  plane(normal(p1, p2, p3), p1)
}

fn triangle(p1: Point3D, p2: Point3D, p3: Point3D) -> Triangle3D {
  Triangle3D { p1, p2, p3 }
}

fn plane(t: Triangle3D) -> Plane {
  plane(t.p1, t.p2, t.p3)
}

fn normal(t: Triangle3D) -> Direction3D {
  normal(t.p1, t.p2, t.p3)
}

fn segment(p1: Point3D, p2: Point3D) -> Segment3D {
  Segment3D { p1, p2 }
}

fn line(p1: Point3D, p2: Point3D) -> Line3D {
  Line3D { p1, p2 }
}

let xyplane = Plane {
  normal: (
    Direction3D {
      _dir: (
        Point3D {
          x: 0,
          y: 0,
          z: 1,
        }
      ),
    }
  ),
  offset: 0,
};

let xzplane = Plane {
  normal: (
    Direction3D {
      _dir: (
        Point3D {
          x: 0,
          y: 1,
          z: 0,
        }
      ),
    }
  ),
  offset: 0,
};

let zyplane = Plane {
  normal: (
    Direction3D {
      _dir: (
        Point3D {
          x: 1,
          y: 0,
          z: 0,
        }
      ),
    }
  ),
  offset: 0,
};

fn circle(plane: Plane, center: Point3D, radius: num) -> Circle3D {
  Circle3D {
    center,
    direction: plane.normal,
    radius: abs(radius),
  }
}

expose package {
  default: true,
  name: "3D geometry",
}
