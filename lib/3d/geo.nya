use "3d/point";

struct Sphere {
  center: Point3D,
  radius: num,
}

fn sphere(center: Point3D, radius: num) -> Sphere {
  Sphere { center, radius }
}

fn %plot_3d(cv: Canvas3D, obj: Sphere) -> Object3D {
  cv.sphere(obj.center.x, obj.center.y, obj.center.z, obj.radius)
}

struct Plane {
  normal: Point3D,
  offset: num,
}

fn plane(normal: Point3D, offset: num) -> Plane {
  Plane { normal, offset }
}

struct Circle3D {
  center: Point3D,
  direction: Point3D,
  radius: num,
}

fn circle(plane: Plane, center: Point3D, radius: num) -> Circle3D {
  Circle3D {
    center,
    direction: plane.normal,
    radius: abs(radius),
  }
}

fn %plot_3d(cv: Canvas3D, p: Circle3D) -> Object3D {
  let c = p.center;
  let d = p.direction;
  cv.circle(c.x, c.y, c.z, d.x, d.y, d.z, p.radius, 4.0)
}

expose package {
  default: true,
  name: "3D geometry",
}
