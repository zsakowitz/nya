use "2d/point";

fn _plot_2d_ray(cv: Canvas, p1: Point, p2: Point) -> Path {
  let x1 = p1.x;
  let y1 = p1.y;
  let x2 = p2.x;
  let y2 = p2.y;

  if x1 == x2 && y1 == y2 {
    return path;
  }

  let ymin = 2 * cv.ymin - cv.ymax;
  let ymax = 2 * cv.ymax - cv.ymin;
  let xmin = 2 * cv.xmin - cv.xmax;
  let xmax = 2 * cv.xmax - cv.xmin;

  let p = path.move_to(cv.point_at(x1, y1));

  if x1 == x2 {
    if y1 < y2 {
      if !(y1 > ymax) {
        p.line_to(cv.point_at(x1, ymax))
      } else {
        p
      }
    } else if !(y1 < ymin) {
      p.line_to(cv.point_at(x1, ymin))
    } else {
      p
    }
  } else {
    let m = (y2 - y1) / (x2 - x1);
    if x1 < x2 {
      if !(x2 > xmax) {
        p.line_to(cv.point_at(xmax, m * (xmax - x1) + y1))
      } else {
        p
      }
    } else if !(x1 < xmin) {
      p.line_to(cv.point_at(xmin, m * (xmin - x1) + y1))
    } else {
      p
    }
  }
}

fn _plot_2d_line(cv: Canvas, p1: Point, p2: Point) -> Path {
  let x1 = p1.x;
  let y1 = p1.y;
  let x2 = p2.x;
  let y2 = p2.y;

  if x1 == x2 && y1 == y2 {
    return path;
  }

  let ymin = 2 * cv.ymin - cv.ymax;
  let ymax = 2 * cv.ymax - cv.ymin;
  let xmin = 2 * cv.xmin - cv.xmax;
  let xmax = 2 * cv.xmax - cv.xmin;

  if x1 == x2 {
    path
      .move_to(cv.point_at(x1, ymin))
      .line_to(cv.point_at(x1, ymax))
  } else {
    let m = (y2 - y1) / (x2 - x1);
    path
      .move_to(cv.point_at(xmin, m * (xmin - x1) + y1))
      .line_to(cv.point_at(xmax, m * (xmax - x1) + y1))
  }
}
