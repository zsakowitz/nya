fn %plot_2d(cv: Canvas, p: CircleCx) -> PathStyled {
  path
    .ellipse(
      cv.point_at(p.center.real, p.center.imag),
      cv.delta_by(p.radius, p.radius),
    )
    .color(dcg_green.r, dcg_green.g, dcg_green.b)
}

fn %plot_2d(cv: Canvas, l: SegmentCx) -> Path {
  path
    .move_to(cv.point_at(l.p1.real, l.p1.imag))
    .line_to(cv.point_at(l.p2.real, l.p2.imag))
}

fn %plot_2d(cv: Canvas, l: LineCx) -> Path {
  let x1 = l.p1.real;
  let y1 = l.p1.imag;
  let x2 = l.p2.real;
  let y2 = l.p2.imag;

  if x1 == x2 && y1 == y2 {
    return path;
  }

  let ymin = 2 * cv.ymin - cv.ymax;
  let ymax = 2 * cv.ymax - cv.ymin;
  let xmin = 2 * cv.xmin - cv.xmax;
  let xmax = 2 * cv.xmax - cv.xmin;

  if x1 == x2 {
    path
      .move_to(cv.point_at(x1, ymin))
      .line_to(cv.point_at(x1, ymax))
  } else {
    let m = (y2 - y1) / (x2 - x1);
    path
      .move_to(cv.point_at(xmin, m * (xmin - x1) + y1))
      .line_to(cv.point_at(xmax, m * (xmax - x1) + y1))
  }
}

fn %plot_2d(cv: Canvas, l: RayCx) -> Path {
  let x1 = l.p1.real;
  let y1 = l.p1.imag;
  let x2 = l.p2.real;
  let y2 = l.p2.imag;

  if x1 == x2 && y1 == y2 {
    return path;
  }

  let ymin = 2 * cv.ymin - cv.ymax;
  let ymax = 2 * cv.ymax - cv.ymin;
  let xmin = 2 * cv.xmin - cv.xmax;
  let xmax = 2 * cv.xmax - cv.xmin;

  let p = path.move_to(cv.point_at(l.p1.real, l.p1.imag));

  if x1 == x2 {
    if y1 < y2 {
      if !(y1 > ymax) {
        p.line_to(cv.point_at(x1, ymax))
      } else {
        p
      }
    } else if !(y1 < ymin) {
      p.line_to(cv.point_at(x1, ymin))
    } else {
      p
    }
  } else {
    let m = (y2 - y1) / (x2 - x1);
    if x1 < x2 {
      if !(x2 > xmax) {
        p.line_to(cv.point_at(xmax, m * (xmax - x1) + y1))
      } else {
        p
      }
    } else if !(x1 < xmin) {
      p.line_to(cv.point_at(xmin, m * (xmin - x1) + y1))
    } else {
      p
    }
  }
}

fn %plot_2d(cv: Canvas, l: VectorCx) -> PathStyled {
  // vector head size
  let size = 12;

  // vector width ratio
  let w = 0.4;

  let o1 = cv.point_at(l.p1.real, l.p1.imag);
  let o2 = cv.point_at(l.p2.real, l.p2.imag);
  if (
    !(is_finite(o1.x) && is_finite(o1.y) && is_finite(o2.x) && is_finite(o2.y))
  ) {
    return path.styled;
  }

  let dx = o2.x - o1.x;
  let dy = o2.y - o1.y;
  let nx = size * dx / @length(dx, dy);
  let ny = size * dy / @length(dx, dy);
  let ox = o2.x - nx;
  let oy = o2.y - ny;

  path
    .move_to(o1)
    .line_to(o2)
    .move_to(o2)
    .line_to(point_at_raw(ox + w * ny, oy - w * nx))
    .line_to(point_at_raw(ox - w * ny, oy + w * nx))
    .line_to(o2)
    .fill_opacity(1.0)
    .color(dcg_blue.r, dcg_blue.g, dcg_blue.b)
}

fn ->(a: AngleCx) -> num {
  let measure = (
    atan(a.p1.real - a.p2.real, a.p1.imag - a.p2.imag)
      - atan(a.p3.real - a.p2.real, a.p3.imag - a.p2.imag)
  )
    % (2 * pi);

  if measure > pi {
    2.0 * pi - measure
  } else {
    measure
  }
}

fn ->(a: DirectedAngleCx) -> num {
  let measure = (
    atan(a.p1.real - a.p2.real, a.p1.imag - a.p2.imag)
      - atan(a.p3.real - a.p2.real, a.p3.imag - a.p2.imag)
      + 2 * pi
  )
    % (2 * pi);

  if measure > pi {
    measure - 2 * pi
  } else {
    measure
  }
}

expose package {
  name: "2D geometry via complex numbers",
  default: true,
}
