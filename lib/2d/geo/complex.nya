use "complex";

// Special syntax to declare multiple structs with the exact same layout.
// Especially useful for geometry functions, which are polymorphic over the
// various types of line and angle.
struct LineCx, VectorCx, SegmentCx, RayCx {
  p1: Complex,
  p2: Complex,
}

type AnyLineCx = LineCx | SegmentCx | RayCx;
type AnySlopeCx = LineCx | VectorCx | SegmentCx | RayCx;

fn line(p1: Complex, p2: Complex) -> LineCx {
  LineCx { p1, p2 }
}

fn vector(p1: Complex, p2: Complex) -> VectorCx {
  VectorCx { p1, p2 }
}

fn segment(p1: Complex, p2: Complex) -> SegmentCx {
  SegmentCx { p1, p2 }
}

fn ray(p1: Complex, p2: Complex) -> RayCx {
  RayCx { p1, p2 }
}

struct ArcCx {
  p1: Complex,
  p2: Complex,
  p3: Complex,
}

fn arc(p1: Complex, p2: Complex, p3: Complex) -> ArcCx {
  ArcCx { p1, p2, p3 }
}

struct AngleCx, DirectedAngleCx {
  p1: Complex,
  p2: Complex,
  p3: Complex,
}

type AnyAngleCx = AngleCx | DirectedAngleCx;

fn angle(p1: Complex, p2: Complex, p3: Complex) -> AngleCx {
  AngleCx { p1, p2, p3 }
}

fn directed_angle(p1: Complex, p2: Complex, p3: Complex) -> DirectedAngleCx {
  DirectedAngleCx { p1, p2, p3 }
}

fn distance(p1: Complex, p2: Complex) -> num {
  @length(p1 @- p2)
}

//! https://en.wikipedia.org/wiki/Distance_from_a_point_to_a_line
fn distance(l: LineCx, p: Complex) -> num {
  let x1 = l.p1.real;
  let y1 = l.p1.imag;
  let x2 = l.p2.real;
  let y2 = l.p2.imag;

  let x0 = p.real;
  let y0 = p.imag;

  abs((y2 - y1) * x0 - (x2 - x1) * y0 + x2 * y1 - y2 * x1)
    / distance(l.p1, l.p2)
}

fn distance(p: Complex, l: LineCx) -> num {
  distance(l, p)
}

fn length(s: SegmentCx | VectorCx) -> num {
  distance(s.p1, s.p2)
}

fn start(v: VectorCx) -> Complex {
  v.p1
}

fn end(v: VectorCx) -> Complex {
  v.p2
}

fn angle_bisector(v: AnyAngleCx) -> RayCx {
  RayCx {
    p1: v.p2,
    p2: @norm(@norm(v.p1 @- v.p2) @+ @norm(v.p3 @- v.p2)) @+ v.p2,
  }
}

fn midpoint(s: SegmentCx) -> Complex {
  @mix(s.p1, s.p2, 0.5)
}

fn midpoint(p1: Complex, p2: Complex) -> Complex {
  @mix(p1, p2, 0.5)
}

struct CircleCx {
  center: Complex,
  radius: num,
}

fn circle(center: Complex, radius: num) -> CircleCx {
  CircleCx { center, radius }
}

fn circle(center: Complex, point_on_radius: Complex) -> CircleCx {
  CircleCx { center, radius: distance(center, point_on_radius) }
}

fn parallel(l: LineCx | SegmentCx | VectorCx | RayCx, p: Complex) -> LineCx {
  LineCx { p1: p, p2: p @+ l.p2 @- l.p1 }
}

fn perpendicular(l: AnySlopeCx, p: Complex) -> LineCx {
  LineCx {
    p1: p,
    p2: (
      Complex {
        real: p.real + l.p2.imag - l.p1.imag,
        imag: p.imag + l.p1.real - l.p2.real,
      }
    ),
  }
}

fn intersection(l1: AnyLineCx, l2: AnyLineCx) -> Complex {
  let x1 = l1.p1.real;
  let y1 = l1.p1.imag;
  let x2 = l1.p2.real;
  let y2 = l1.p2.imag;

  let x3 = l2.p1.real;
  let y3 = l2.p1.imag;
  let x4 = l2.p2.real;
  let y4 = l2.p2.imag;

  let d = (x1 - x2) * (y3 - y4) - (y1 - y2) * (x3 - x4);

  let x1y2 = x1 * y2;
  let x2y1 = y1 * x2;
  let x3y4 = x3 * y4;
  let x4y3 = y3 * x4;

  let base = Complex {
    real: (x1y2 - x2y1) * (x3 - x4) - (x1 - x2) * (x3y4 - x4y3),
    imag: (x1y2 - x2y1) * (y3 - y4) - (y1 - y2) * (x3y4 - x4y3),
  };

  // TODO: optimize this as a determinant call
  base @/ d
}

//! https://stackoverflow.com/a/37225895
// `which` should be -1 | 1
fn _intersection(l: AnyLineCx, c: CircleCx, which: num) -> Complex {
  let cx = c.center.real;
  let cy = c.center.imag;
  let r = c.radius;

  let x1 = l.p1.real;
  let y1 = l.p1.imag;
  let x2 = l.p2.real;
  let y2 = l.p2.imag;

  let v1 = l.p2 @- l.p1;
  let v2 = l.p1 @- c.center;

  let b = -2.0 * (v1.real * v2.real + v1.imag * v2.imag);
  let c = 2.0 * (v1.real * v1.real + v1.imag * v1.imag);
  let d = sqrt(
    b * b - 2.0 * c * (v2.real * v2.real + v2.imag * v2.imag - r * r),
  );

  if is_nan(d) {
    _complex_nan
  } else {
    l.p1 @+ v1 @* ((b + which * d) / c)
  }
}

// `which` should be -1 | 1
fn _intersection(c1: CircleCx, c2: CircleCx, which: num) -> Complex {
  let x0 = c1.center.real;
  let y0 = c1.center.imag;
  let r0 = c1.radius;

  let x1 = c2.center.real;
  let y1 = c2.center.imag;
  let r1 = c2.radius;

  let dx = x1 - x0;
  let dy = y1 - y0;
  // TODO: dot product
  let d = sqrt(dx * dx + dy * dy);

  // circles do not intersect
  if d > r0 + r1 || d < abs(r0 - r1) || d == 0 && r0 == r1 {
    _complex_nan
  } else {
    // dot product
    let a = (r0 * r0 - r1 * r1 + d * d) / (2 * d);
    let h = sqrt(r0 * r0 - a * a);
    c1.center @+ Complex { real: -dy, imag: dx } @* (which * h / d)
      @+ Complex { real: dx, imag: dy } @* (a / d)
  }
}

fn perpendicular_bisector(p1: Complex, p2: Complex) -> LineCx {
  let l1a = midpoint(p1, p2);
  let l1b = Complex {
    real: l1a.real + (p2.imag - p1.imag),
    imag: l1a.imag - (p2.real - p1.real),
  };
  LineCx { p1: l1a, p2: l1b }
}

fn perpendicular_bisector(s: SegmentCx) -> LineCx {
  perpendicular_bisector(s.p1, s.p2)
}

fn circle(arc: ArcCx) -> CircleCx {
  let p1 = arc.p1;
  let p2 = arc.p2;
  let p3 = arc.p3;

  let c = intersection(
    perpendicular_bisector(p1, p2),
    perpendicular_bisector(p3, p2),
  );

  CircleCx { center: c, radius: @length(c @- p1) }
}

fn intersection(c: CircleCx, l: AnyLineCx) -> Complex {
  _intersection(l, c, 1)
}

fn intersection(l: AnyLineCx, c: CircleCx) -> Complex {
  _intersection(l, c, -1)
}

fn intersection(a: CircleCx, b: CircleCx) -> Complex {
  _intersection(a, b, 1)
}

fn glider(a: CircleCx, at: num) -> Complex {
  let at = 2 * pi * clamp(at, 0.0, 1.0);
  Complex {
    real: a.center.real + a.radius * cos(at),
    imag: a.center.imag + a.radius * sin(at),
  }
}

fn glider(l: LineCx, at: num) -> Complex {
  @mix(l.p1, l.p2, at)
}

fn glider(l: RayCx, at: num) -> Complex {
  @mix(l.p1, l.p2, max(0.0, at))
}

fn glider(l: SegmentCx, at: num) -> Complex {
  @mix(l.p1, l.p2, clamp(at, 0.0, 1.0))
}

fn start(a: ArcCx) -> Complex {
  a.p1
}

fn end(a: ArcCx) -> Complex {
  a.p3
}

